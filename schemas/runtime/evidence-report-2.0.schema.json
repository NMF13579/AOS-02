{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aos02.dev/schemas/runtime/evidence-report-2.0.schema.json",
  "title": "AOS-02 Runtime Evidence Report v2",
  "type": "object",
  "required": ["record_type", "schema_version", "evidence_id", "task_binding", "baseline_binding", "technical_status", "reason_codes", "checks", "unknowns", "not_run", "blockers"],
  "properties": {
    "record_type": {"const": "EVIDENCE_REPORT"},
    "schema_version": {"const": "2.0"},
    "evidence_id": {"type": "string", "minLength": 1},
    "task_binding": {"type": "string", "minLength": 1},
    "baseline_binding": {"type": "string", "minLength": 1},
    "technical_status": {"enum": ["PASS", "FAIL", "BLOCKED", "UNKNOWN_BLOCKED", "NOT_RUN", "HUMAN_REVIEW_REQUIRED"]},
    "reason_codes": {"type": "array", "items": {"enum": ["BASELINE_BINDING_MISMATCH", "BUNDLE_LOAD_ERROR", "EVIDENCE_BINDING_MISMATCH", "EVIDENCE_INCOMPLETE", "EVIDENCE_NOT_PASS", "EVIDENCE_REQUIRED_CHECK_COVERAGE_MISMATCH", "EVIDENCE_TASK_BINDING_MISMATCH", "EVIDENCE_TECHNICAL_STATUS_NOT_PASS", "FORBIDDEN_APPROVAL_CLAIM", "FORBIDDEN_GIT_AUTHORITY_CLAIM", "INTERNAL_ERROR", "INVALID_SCOPE_PATH_LIST", "LOCAL_DECLARED_HUMAN_REFERENCE_NOT_TRUSTED", "LOCAL_EXECUTION_NOT_AUTHORIZED", "MISSING_REQUIRED_CHECK", "MUTATING_EXECUTOR_DISABLED", "NONPORTABLE_OPERATION_PATH", "NONPORTABLE_SCOPE_PATH", "OPERATIONS_REQUIRED", "OPERATION_IN_FORBIDDEN_SCOPE", "OPERATION_OUTSIDE_SCOPE", "PORTABILITY_PATH_COLLISION", "REQUEST_BASELINE_BINDING_MISMATCH", "REQUEST_TASK_BINDING_MISMATCH", "REQUIRED_CHECK_FAILED", "REQUIRED_CHECK_NOT_RUN", "SCHEMA_VALIDATION_FAILED", "SCOPE_CONFLICT", "TASK_BINDING_MISMATCH", "TRUSTED_HUMAN_AUTHORITY_NOT_IMPLEMENTED", "UNKNOWN_DECISION_VALUE", "WRONG_DECISION_TYPE", "WRONG_REQUEST_TYPE"]}, "uniqueItems": true},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "exit_code", "output_reference"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "UNKNOWN_BLOCKED", "NOT_RUN", "HUMAN_REVIEW_REQUIRED"]},
          "exit_code": {"type": "integer", "minimum": 0},
          "output_reference": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "not_run": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "additionalProperties": false
}
