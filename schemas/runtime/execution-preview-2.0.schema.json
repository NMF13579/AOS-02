{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aos02.dev/schemas/runtime/execution-preview-2.0.schema.json",
  "title": "AOS-02 Runtime Execution Preview v2",
  "type": "object",
  "required": ["record_type", "schema_version", "task_binding", "baseline_binding", "state", "execution_readiness", "reason_codes", "will_modify_files", "operation_count", "operations"],
  "properties": {
    "record_type": {"const": "EXECUTION_PREVIEW"},
    "schema_version": {"const": "2.0"},
    "task_binding": {"type": "string", "minLength": 1},
    "baseline_binding": {"type": "string", "minLength": 1},
    "state": {"const": "PREVIEW_BLOCKED"},
    "execution_readiness": {"const": "BLOCKED"},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "will_modify_files": {"const": false},
    "operation_count": {"type": "integer", "minimum": 0},
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "path"],
        "properties": {
          "action": {"const": "WRITE"},
          "path": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
