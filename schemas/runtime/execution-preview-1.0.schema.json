{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aos02.dev/schemas/runtime/execution-preview-1.0.schema.json",
  "title": "AOS-02 Runtime Execution Preview",
  "description": "Non-mutating preview record from the existing scoped execution boundary. PREVIEW_READY does not authorize execution.",
  "type": "object",
  "required": ["state", "reason_codes", "will_modify_files", "operation_count"],
  "properties": {
    "state": {"enum": ["PREVIEW_READY", "PREVIEW_BLOCKED"]},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "will_modify_files": {"const": false},
    "operation_count": {"type": "integer", "minimum": 0},
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "path"],
        "properties": {
          "action": {},
          "path": {}
        },
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "PREVIEW_READY"}}},
      "then": {"required": ["operations"]}
    }
  ],
  "additionalProperties": true
}
