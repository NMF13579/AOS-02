{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aos02.dev/schemas/runtime/scope-and-change-1.0.schema.json",
  "title": "AOS-02 Runtime Scope and Change",
  "description": "Bounded scope record. Schema validation does not authorize execution or scope expansion.",
  "type": "object",
  "required": ["record_type", "scope_id", "idea_binding", "allowed_paths", "forbidden_paths"],
  "properties": {
    "record_type": {"const": "SCOPE_AND_CHANGE"},
    "scope_id": {"type": "string", "minLength": 1},
    "idea_binding": {"type": "string", "minLength": 1},
    "allowed_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "forbidden_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": true
}
