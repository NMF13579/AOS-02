{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aos02.dev/schemas/runtime/evidence-report-1.0.schema.json",
  "title": "AOS-02 Runtime Evidence Report",
  "type": "object",
  "required": ["record_type", "schema_version", "status", "reason_codes", "checks"],
  "properties": {
    "record_type": {"const": "EVIDENCE_REPORT"},
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "task_binding": {"type": "string", "minLength": 1},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "checks": {"type": "array", "items": {"type": "object"}},
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "evidence_artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "PASS"}}},
    "then": {"required": ["task_binding", "operations", "evidence_artifact"]}
  }],
  "additionalProperties": true
}
