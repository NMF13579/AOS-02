{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aos02.dev/schemas/runtime/execution-request-2.0.schema.json",
  "title": "AOS-02 Runtime Execution Request v2",
  "type": "object",
  "required": ["record_type", "schema_version", "task_binding", "baseline_binding", "operations"],
  "properties": {
    "record_type": {"const": "EXECUTION_REQUEST"},
    "schema_version": {"const": "2.0"},
    "task_binding": {"type": "string", "minLength": 1},
    "baseline_binding": {"type": "string", "minLength": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "path", "content"],
        "properties": {
          "action": {"const": "WRITE"},
          "path": {"type": "string", "minLength": 1},
          "content": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
