{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aos02.dev/schemas/runtime/task-brief-2.0.schema.json",
  "title": "AOS-02 Runtime Task Brief v2",
  "type": "object",
  "required": ["record_type", "schema_version", "status", "task_id", "idea_binding", "risk_binding", "scope_binding", "baseline_binding", "allowed_paths", "forbidden_paths", "required_checks"],
  "properties": {
    "record_type": {"const": "TASK_BRIEF"},
    "schema_version": {"const": "2.0"},
    "status": {"const": "DRAFT"},
    "task_id": {"type": "string", "minLength": 1},
    "idea_binding": {"type": "string", "minLength": 1},
    "risk_binding": {"type": "string", "minLength": 1},
    "scope_binding": {"type": "string", "minLength": 1},
    "baseline_binding": {"type": "string", "minLength": 1},
    "allowed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "forbidden_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "required_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "human_decision_required": {"const": true},
    "execution_authorized": {"const": false},
    "commit_authorized": {"const": false},
    "push_authorized": {"const": false},
    "merge_authorized": {"const": false},
    "release_authorized": {"const": false}
  },
  "additionalProperties": false
}
